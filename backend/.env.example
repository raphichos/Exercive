# Copy this file to backend/.env and adjust it. Never commit the copy.
# Phase 2 adds JWT_SECRET.

# One of: development, test, production
ENVIRONMENT=development

# Where the database lives. Leave unset to use a SQLite file at backend/exercive.db.
# Production uses PostgreSQL, for example:
# DATABASE_URL=postgresql+psycopg://user:password@host/dbname
